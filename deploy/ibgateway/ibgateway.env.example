# Credencials d'IB Gateway. Copia a /etc/finance/ibgateway.env (chmod 600). Mai al repositori.
# Recomanat: un usuari secundari d'IBKR només per a l'API (Settings → Users & Access Rights),
# sense permisos de retirada de fons.
TWS_USERID=
TWS_PASSWORD=
# paper (port 4002) o live (port 4001)
TRADING_MODE=paper
READ_ONLY_API=no
TIME_ZONE=Europe/Madrid
# Per veure la sessió per VNC (túnel SSH al port 5900) la primera vegada
VNC_SERVER_PASSWORD=
