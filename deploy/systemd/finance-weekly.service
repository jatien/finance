[Unit]
Description=finance: manteniment setmanal (univers, metadades, compactació)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@FIN_USER@
Group=@FIN_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@APP_DIR@/.venv/bin/fin run weekly
Nice=15
TimeoutStartSec=4h
