# Copia a .env (desenvolupament) o a /etc/finance/finance.env (servidor) i omple-ho.
# Totes les variables tenen el prefix FIN_.

# Arrel del data lake (Parquet + catàleg DuckDB). Fora del repositori.
FIN_DATA_DIR=~/finance-data

# Clau gratuïta de FRED: https://fred.stlouisfed.org/docs/api/api_key.html
# Sense clau, les sèries revisables (ocupació, IPC...) no tenen vintages point-in-time.
FIN_FRED_API_KEY=

# Fitxer d'univers (per defecte config/universe.yaml del repositori)
# FIN_UNIVERSE_FILE=/srv/finance/app/config/universe.yaml

# Nivell de log: DEBUG, INFO, WARNING
FIN_LOG_LEVEL=INFO
