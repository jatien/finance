# Copia a .env (desenvolupament) o a /etc/finance/finance.env (servidor) i omple-ho.
# Totes les variables tenen el prefix FIN_.

# Arrel del data lake (Parquet + catàleg DuckDB). Fora del repositori.
FIN_DATA_DIR=~/finance-data

# Clau gratuïta de FRED: https://fred.stlouisfed.org/docs/api/api_key.html
# Sense clau, les sèries revisables (ocupació, IPC...) no tenen vintages point-in-time.
FIN_FRED_API_KEY=

# Fitxer d'univers (per defecte config/universe.yaml del repositori)
# FIN_UNIVERSE_FILE=/srv/finance/app/config/universe.yaml

# Nivell de log: DEBUG, INFO, WARNING
FIN_LOG_LEVEL=INFO

# Paper trading: capital nocional per convertir pesos en imports a l'informe diari
# FIN_PAPER_CAPITAL=10000
# FIN_PAPER_CURRENCY=USD

# SEC EDGAR (operaciones de insiders, Form 4). La SEC exige un User-Agent con nombre y
# correo; sin él, la ingesta de insiders se omite. Gratuito, sin clave.
FIN_SEC_USER_AGENT=
# FIN_INSIDER_START_YEAR=2006
# --- Setmana 11: alertes actives (docs/ejecucion.md) --------------------------------------
# ntfy (recomanat): instal·la l'app ntfy al mòbil i subscriu-te a un tema difícil d'endevinar
# FIN_ALERT_NTFY_URL=https://ntfy.sh/finance-canvia-aixo-per-un-nom-aleatori
# FIN_ALERT_NTFY_TOKEN=
# Telegram: bot creat amb @BotFather + el teu chat_id
# FIN_ALERT_TELEGRAM_TOKEN=
# FIN_ALERT_TELEGRAM_CHAT_ID=
# Correu (SMTP amb STARTTLS)
# FIN_ALERT_SMTP_HOST=smtp.gmail.com
# FIN_ALERT_SMTP_PORT=587
# FIN_ALERT_SMTP_USER=
# FIN_ALERT_SMTP_PASSWORD=
# FIN_ALERT_SMTP_TO=
# Nivell mínim: info | important | critical
# FIN_ALERT_MIN_LEVEL=important
# FIN_ALERT_WEEKLY_SUMMARY=true
# Vigilància externa (healthchecks.io): avisa si el pipeline no arriba a executar-se
# FIN_ALERT_HEALTHCHECK_URL=https://hc-ping.com/uuid

# --- Setmana 11: execució real ------------------------------------------------------------
# off | manual | ibkr
# FIN_EXEC_MODE=off
# FIN_EXEC_STRATEGY=rot_v1b
# Mode manual: efectiu inicial del compte (EUR)
# FIN_EXEC_CAPITAL=0
# IB Gateway: 4002 = paper, 4001 = real
# FIN_IBKR_PORT=4002
# FIN_IBKR_CLIENT_ID=17
# Compte REAL: les dues línies són obligatòries i cada pla s'ha d'aprovar (fin exec approve)
# FIN_EXEC_LIVE=false
# FIN_EXEC_ACCOUNT=U1234567
# Límits (valors per defecte)
# FIN_EXEC_BAND=0.05
# FIN_EXEC_MIN_ORDER=250
# FIN_EXEC_LIMIT_BPS=30
# FIN_EXEC_MAX_PRICE_MOVE=0.03
# FIN_EXEC_MAX_ORDER_PCT=0.8
